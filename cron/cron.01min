#!/bin/sh
# Govee - Waechter, minuetlich.
# Startet den Dienst neu, wenn er laufen soll, aber nicht laeuft.
# Den bin-Pfad des Plugins setzt der Installer in der Befehlszeile ein.
# Ausdruecklich ueber die Shell aufrufen: geht bei einem misslungenen Update
# das Ausfuehrungsrecht an dienst.sh verloren, schluege der unmittelbare
# Aufruf lautlos fehl - die Ausgabe geht nach /dev/null, und niemand bemerkte,
# dass der Waechter nicht mehr laeuft.
/bin/bash "REPLACELBPBINDIR/dienst.sh" waechter >/dev/null 2>&1
# Waechter der Befehlsbruecke (Gruppe 3 / MQTT, 0.9.30; Brueckenbericht 5 Nr. 1): startet, haelt an, sendet
# <praefix>/status/befehle. Fehler bleiben auf stderr (Protokoll des Installers bzw. cron).
/bin/bash "REPLACELBPBINDIR/befehlsbruecke.sh" waechter >/dev/null
