#!/bin/bash
# Govee - Deinstallation
#
# Die Deinstallation von LoxBerry entfernt nur das VERZEICHNIS
# config/plugins/<ordner>/. Eine Sicherungsdatei DANEBEN -
# config/plugins/<ordner>.backup.json - bliebe liegen. Beim WifiScanner
# enthielt so eine Datei die MAC-Adressen und Namen aller ueberwachten
# Personen. Hier stehen zwar nur IP-Adressen und Geraetekennungen drin, aber
# es gibt keinen Grund, sie liegen zu lassen.
SELF=$(cd "$(dirname "$0")" && pwd)
PFOLDER=$(basename "$(cd "$SELF/.." && pwd)")
BASE=${LBHOMEDIR:-$(cd "$SELF/../../.." 2>/dev/null && pwd)}

DIENST="$BASE/bin/plugins/$PFOLDER/dienst.sh"
[ -x "$DIENST" ] && "$DIENST" stop >/dev/null 2>&1

PID="$BASE/data/plugins/$PFOLDER/dienst.pid"
if [ -f "$PID" ]; then
    kill -9 "$(cat "$PID")" 2>/dev/null || true
    rm -f "$PID"
fi

# ALLE Sicherungen neben dem Ordner - der Installer raeumt sie nicht weg.
# Bis 0.9.8 stand hier nur die erste Zeile. Zurueck blieben damit
# <ordner>.backup.govee.json mit dem Aktionstoken und - schwerer -
# <ordner>.backup.geheim.json mit dem gueltigen Govee-API-Schluessel. Der
# Kommentar oben nennt den WifiScanner-Fall; das hier war derselbe.
# Der zweite Name stammt aus 0.9.8 und wird nur noch weggeraeumt.
rm -f "$BASE/config/plugins/$PFOLDER.backup.json"
rm -f "$BASE/config/plugins/$PFOLDER.backup.govee.json"
rm -f "$BASE/config/plugins/$PFOLDER.backup.geheim.json"
# Die Datei mit dem Cloud-Schluessel liegt im Ordner und geht mit ihm; zur
# Sicherheit trotzdem ausdruecklich loeschen, falls der Ordner stehen bleibt.
rm -f "$BASE/config/plugins/$PFOLDER/geheim.json"
rm -rf "$BASE/data/plugins/$PFOLDER"

echo "<OK> Govee-Plugin entfernt, Sicherungsdatei und Cloud-Schluessel geloescht."
exit 0
